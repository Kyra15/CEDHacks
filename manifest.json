{
  "manifest_version": 3,
  "name": "NewsCheck",
  "version": "0.1.0",
  "description": "An extension to help fact-check news articles and reveal biases in writing",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["https://api.groq.com/*"],

  "web_accessible_resources": [
    {
        "resources": ["libs/Readability.js", "libs/extract.js"],
        "matches": ["<all_urls>"]
    }
  ]
}