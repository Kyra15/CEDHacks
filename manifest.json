{
  "manifest_version": 3,
  "name": "Veri-feed",
  "description": "Extension to check biases and truthful claims using AI",
  "version": "0.1",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://groq.api/*"
  ],
  "permissions": [
    "storage", "activeTab"
  ]
}
